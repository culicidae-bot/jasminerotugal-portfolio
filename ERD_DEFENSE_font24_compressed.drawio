<mxfile host="app.diagrams.net" scale="1" border="0">
  <diagram name="Page-1" id="3RI5ZSR4A_tj57OiXwJR">
    <mxGraphModel dx="3450" dy="2317" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    %% ISUCauFA Complete Entity-Relationship Diagram\n    %% One unified ERD. Every entity is declared once.\n    %% Three referenced entities have no attribute definitions in the supplied source:\n    %% LoginAttemptLog, PushSubscription, and MonthlyAssessment.\n    direction TB\n\n    %% =========================\n    %% ORGANIZATION AND ACCOUNTS\n    %% =========================\n    Department ||--o{ OfficerUser : has_officers\n    OfficerUser ||--o{ Department : heads\n    Department ||--o{ Member : assigned_to\n    OfficerUser ||--o{ Member : linked_member_profiles\n    OfficerUser ||--o{ AccessSession : owns\n    OfficerUser ||--o{ LoginAttemptLog : records\n    OfficerUser ||--o{ OfflineBotChallenge : bot_challenges\n\n    %% =========================\n    %% MEMBER AND ADMINISTRATION\n    %% =========================\n    OfficerUser ||--o{ MemberRegistrationRequest : processes\n    Member ||--o{ MemberRegistrationRequest : enrollment_request\n    Member ||--o{ MonthlyDues : has\n    OfficerUser ||--o{ MonthlyDues : approves\n    Member ||--o{ Contribution : contributes\n    OfficerUser ||--o{ Contribution : records\n    Member ||--o{ MonthlyAssessment : assessed\n    Member ||--o{ PushSubscription : subscribes\n\n    %% =========================\n    %% NOTIFICATIONS AND DOCUMENTS\n    %% =========================\n    OfficerUser ||--o{ Notification : receives\n    Member ||--o{ Notification : receives\n    OfficerUser ||--o{ SupportingProof : uploads\n    Member ||--o{ SupportingProof : uploaded_for\n    AidTrackingPost ||--o{ SupportingProof : has_proof\n    AidTrackingPost ||--o{ Notification : related_post\n    OrganizationFundReport ||--o{ Notification : informs\n\n    %% =========================\n    %% CONTRIBUTIONS AND REPORTS\n    %% =========================\n    OfficerUser ||--o{ OrganizationFundReport : prepares\n    OfficerUser ||--o{ AuditFindingsReport : prepares\n\n    %% =========================\n    %% AID AND VERIFICATION\n    %% =========================\n    Member ||--o{ AidTrackingPost : has_aid_posts\n    Member ||--o{ MedicalAid : files\n    Member ||--o{ DeathAid : files\n    Member ||--o{ Claimant : names_claimant\n    OfficerUser ||--o{ MedicalAid : validates\n    OfficerUser ||--o{ DeathAid : validates\n    Claimant ||--o{ DeathAid : referenced_by\n    OfficerUser ||--o{ TransactionVerification : audits\n    MedicalAid ||--o{ TransactionVerification : may_be_verified_by\n    DeathAid ||--o{ TransactionVerification : may_be_verified_by\n\n    %% =========================\n    %% ENTITY ATTRIBUTES\n    %% =========================\n    Department {\n        int department_id PK\n        string name\n        string code\n        int head_officer_id FK\n        bool is_active\n    }\n\n    OfficerUser {\n        int user_id PK\n        string full_name\n        string username\n        string password_hash\n        string role\n        int department_id FK\n        string account_status\n        date term_start\n        date term_end\n        bool mfa_enabled\n        bool authenticator_enabled\n        string email\n        string action_pin_hash\n        datetime action_pin_set_at\n        int action_pin_fail_count\n        datetime action_pin_locked_until\n        int action_pin_lock_minutes\n    }\n\n    Member {\n        int member_id PK\n        string full_name\n        string employee_id\n        int officer_user_id FK\n        int department_id FK\n        string department\n        string position\n        string email\n        string employment_status\n        string membership_status\n        date date_joined\n        string member_classification\n        bool push_enabled\n    }\n\n    AccessSession {\n        int session_id PK\n        int user_id FK\n        string token_id\n        string ip_address\n        string device_info\n        datetime issued_at\n        datetime expires_at\n        datetime revoked_at\n        bool trusted_device\n    }\n\n    MemberRegistrationRequest {\n        int request_id PK\n        int member_id FK\n        string full_name\n        string employee_id\n        string email\n        date payment_date\n        string status\n        string returned_reason\n    }\n\n    MonthlyDues {\n        int dues_id PK\n        int member_id FK\n        string month_covered\n        decimal amount\n        string payment_status\n        string treasurer_status\n        string auditor_status\n    }\n\n    Contribution {\n        int contribution_id PK\n        int member_id FK\n        int recorded_by_user_id FK\n        date contribution_date\n        decimal amount\n        string contribution_type\n    }\n\n    AidTrackingPost {\n        int aid_tracking_post_id PK\n        int member_id FK\n        decimal aid_amount\n        string status\n        date submitted_date\n    }\n\n    SupportingProof {\n        int proof_id PK\n        int content_type_id\n        int object_id\n        string file_name\n        string file_type\n        string document_type\n        string file_sha256\n    }\n\n    Notification {\n        int notification_id PK\n        int recipient_id\n        string recipient_type\n        string message\n        string notification_type\n        string delivery_status\n    }\n\n    OrganizationFundReport {\n        int report_id PK\n        string report_period\n        string report_type\n        string report_status\n        int prepared_by_user_id FK\n        datetime created_at\n    }\n\n    AuditFindingsReport {\n        int audit_report_id PK\n        string report_title\n        string report_period\n        string findings_summary\n        string report_status\n        int prepared_by_user_id FK\n    }\n\n    MedicalAid {\n        int medical_aid_id PK\n        int member_id FK\n        date request_date\n        decimal requested_amount\n        string hospital_name\n        decimal hospital_bill_amount\n        int claim_year\n        string document_status\n        string policy_record_status\n        decimal validated_aid_amount\n        string status\n        int treasurer_validated_by_user_id FK\n        int auditor_verified_by_user_id FK\n        int president_decided_by_user_id FK\n        string president_decision\n        string disbursement_source\n        int released_by_user_id FK\n        string release_reference\n    }\n\n    DeathAid {\n        int death_aid_id PK\n        int member_id FK\n        int claimant_id FK\n        date claim_date\n        string claim_type\n        string deceased_name\n        string relationship_to_member\n        string relationship_group\n        decimal benefit_amount\n        string document_status\n        string status\n        int treasurer_validated_by_user_id FK\n        int auditor_verified_by_user_id FK\n        int president_decided_by_user_id FK\n        string disbursement_source\n        int released_by_user_id FK\n    }\n\n    Claimant {\n        int claimant_id PK\n        int member_id FK\n        string full_name\n        string relationship_to_member\n        string relationship_group\n        string authorization_status\n    }\n\n    TransactionVerification {\n        int verification_id PK\n        string table_name\n        int record_id\n        string target_category\n        string verification_status\n        int auditor_id FK\n        string auditor_remarks\n        string evidence_file_hash\n        int returned_by_auditor_id FK\n        int president_id FK\n        datetime verified_at\n        datetime approved_at\n    }\n\n    OfflineBotChallenge {\n        string challenge_id PK\n        string username\n        string salt\n        int difficulty\n        datetime expires_at\n        datetime used_at\n        datetime created_at\n    }\n\n    %% The following three entities are intentionally shown without attributes\n    %% because their column definitions were not included in the provided schema.\n    LoginAttemptLog\n    PushSubscription\n    MonthlyAssessment\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="Znv_pHJfbrLSCZ_yswMP-1">
